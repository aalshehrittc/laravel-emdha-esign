{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "tcc/laravel-emdha-esign",
    "description": "Laravel package for EMDHA eSign digital signature integration — Saudi Arabia's digital signing platform",
    "keywords": ["laravel", "emdha", "esign", "digital-signature", "saudi-arabia", "tcc"],
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "TCC",
            "email": "dev@tcc.sa"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/support": "^9.0 || ^10.0 || ^11.0 || ^12.0",
        "illuminate/http": "^9.0 || ^10.0 || ^11.0 || ^12.0",
        "symfony/process": "^6.0 || ^7.0"
    },
    "require-dev": {
        "orchestra/testbench": "^7.0 || ^8.0 || ^9.0 || ^10.0",
        "pestphp/pest": "^2.0 || ^3.0",
        "pestphp/pest-plugin-laravel": "^2.0 || ^3.0"
    },
    "autoload": {
        "psr-4": {
            "Tcc\\EmdhaEsign\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tcc\\EmdhaEsign\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test:coverage": "vendor/bin/pest --coverage"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Tcc\\EmdhaEsign\\EmdhaServiceProvider"
            ],
            "aliases": {
                "Emdha": "Tcc\\EmdhaEsign\\Facades\\EmdhaFacade"
            }
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}